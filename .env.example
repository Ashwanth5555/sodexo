# Copy this to .env.sodexo - NOT .env, which is not read (see config.py).
# Every key is optional; the defaults in backend_sodexo/app/core/config.py are
# what runs when the file is absent. Keys config.py does not define are
# ignored, so this file lists only the ones that actually do something.

# --- Database ---------------------------------------------------------------
# Postgres also works, but note that the additive schema migration in
# app/core/schema.py only runs for sqlite - a Postgres deployment needs real
# migration tooling.
DATABASE_URL=sqlite:///./data/sodexo.db

# --- Single-tenant POC behaviour --------------------------------------------
# true  = wipe ALL data on every startup: canonical facts, uploaded datasets,
#         the files behind them, every model run and training job. The app
#         comes up empty, so one client never sees another's data and a
#         restart is a guaranteed clean slate. This is the deployed setting.
# false = keep data across restarts. Use this locally, where re-loading the
#         sample and retraining on every reload is painful.
RESET_ON_STARTUP=true

# --- Training concurrency ---------------------------------------------------
# Series are fitted in parallel. 0 = decide automatically from the cgroup CPU
# quota and memory limit, which is the right answer inside a container. Set a
# number to pin it where neither is detectable, or to leave headroom.
# On Azure Container Apps at 2 vCPU / 4Gi, leave at 0 or set to 2.
TRAINING_MAX_WORKERS=0

# --- Auth -------------------------------------------------------------------
# Change the secret and every password for anything that is not a local demo.
# The defaults are published in the README, so a deployment that keeps them
# has no access control worth the name.
AUTH_SECRET_KEY=change-me-in-production
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_ADMIN_PASSWORD=Admin@2026
AUTH_MANAGER_PASSWORD=Manager@2026
AUTH_ANALYST_PASSWORD=Analyst@2026
# true = every /api route requires a token, not only the UI. Off by default
# because the ingestion/training scripts and /docs call the API without one.
AUTH_PROTECT_API=false

# --- AI Assistant (optional) ------------------------------------------------
# Without a key the assistant falls back to a template summariser over the
# same retrieved facts, so the app is fully functional either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
