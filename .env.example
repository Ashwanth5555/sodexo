# Database
# Local dev without Docker: sqlite file (default below).
# In docker-compose: postgresql+psycopg2://labor:labor@postgres:5432/labor_forecasting
DATABASE_URL=sqlite:///./data/labor_forecasting.db

# Auth - the three application logins. Change the secret and passwords for
# anything that isn't a local demo.
AUTH_SECRET_KEY=change-me-in-production
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_ADMIN_PASSWORD=Admin@2026
AUTH_MANAGER_PASSWORD=Manager@2026
AUTH_ANALYST_PASSWORD=Analyst@2026
# true = every /api route requires a token, not only the UI.
AUTH_PROTECT_API=false

# Mock enterprise API layer (this app's own mock source-system service)
MOCK_API_BASE_URL=http://localhost:8100

# Backend application API
BACKEND_API_PORT=8000
MOCK_API_PORT=8100

# LLM (GenAI assistant) - pluggable, optional. App works fully without either set.
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MLflow
MLFLOW_TRACKING_URI=file:./ml/mlruns

# Demo "as of" date - workforce operational data ends 2026-07-31.
# "Today" screens resolve against this instead of the wall clock so the demo
# doesn't show an empty/stale "today" when run after the data window ends.
APP_DEMO_ASOF_DATE=2026-07-31

# Punch analytics thresholds (configurable, not hard-coded in business logic)
EARLY_CLOCK_THRESHOLD_MINUTES=10
LATE_CLOCK_THRESHOLD_MINUTES=6
DUPLICATE_PUNCH_WINDOW_SECONDS=120
LONG_BREAK_THRESHOLD_MINUTES=45
MAX_SHIFT_DURATION_HOURS=12
EXCESSIVE_HOURS_WEEKLY_THRESHOLD=50

# Risk thresholds (configurable)
RISK_THRESHOLD_LOW=0.25
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_HIGH=0.75
